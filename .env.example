# ==============================================================================
# NovaBank AI-Powered Banking Customer Query Assistant
# Environment Configuration Template
# ==============================================================================

# LLM Configuration
# Options for LLM_PROVIDER: "openrouter", "openai", or "mock"
#
# For OpenRouter:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openai/gpt-4o-mini  # or deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
#   LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://openrouter.ai/api/v1  # optional, defaults automatically
#
# For OpenAI:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# For Mock / Offline rule-based mode:
#   LLM_PROVIDER=mock
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Orchestrator Configuration
ORCHESTRATOR_MAX_STEPS=8
ORCHESTRATOR_MAX_TOOL_CALLS=5
ORCHESTRATOR_MAX_RETRIES=1

# RAG Configuration
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_QDRANT_COLLECTION_NAME=novabank_knowledge
RAG_QDRANT_STORAGE_PATH=qdrant_storage
RAG_QDRANT_VECTOR_SIZE=384
RAG_QDRANT_DISTANCE=cosine
